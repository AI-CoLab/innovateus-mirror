[
  {
    "id": 31,
    "fullname": "Innovation Skills Accelerator",
    "displayname": "Innovation Skills Accelerator",
    "shortname": "Innovation Skills",
    "courseimage": "https://course.innovate-us.org/pluginfile.php/3137/course/overviewfiles/insa-course-image.png",
    "categoryid": 5,
    "categoryname": "InnovateUS",
    "sortorder": 10006,
    "summary": "<p dir=\"ltr\" style=\"text-align:left;\"></p><ul><li id=\"module-366\"><div><div><div><div><div><div><div><h3><strong>Welcome to the Innovation Skills Accelerator Course!</strong></h3><p dir=\"ltr\">Based on research with thousands of public servants across three continents, our problem-solving curriculum gives you the digital, data and innovation skills to deliver more effective, equitable and engaged policies and services. </p><br /><p dir=\"ltr\">This course is presented by Professor Beth Simone Noveck.</p><br /><p dir=\"ltr\">Beth Simone Noveck is a professor at <a href=\"https://www.northeastern.edu/\">Northeastern University</a>, where she directs <a href=\"https://burnes.northeastern.edu/\">the Burnes Center for Social Change</a> and its partner project, <a href=\"https://thegovlab.org/\">The GovLab</a>. In 2019, Beth was appointed the State of New Jersey’s first Chief Innovation Officer by Governor Phil Murphy, where her team are using new technology to improve equitable government delivery of services. Previously, Beth served in the White House as the first United States Deputy Chief Technology Officer under President Obama.</p></div></div></div></div></div></div></div></li></ul><br /><p></p>",
