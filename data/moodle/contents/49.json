  {
    "id": 380,
    "name": "2. Understanding AI's Potential for Public Procurement",
    "visible": 1,
    "summary": "<p>What AI is, how it can support procurement work, and how the profession will change as AI becomes part of government operations.</p>",
    "summaryformat": 1,
    "section": 2,
    "hiddenbynumsections": 0,
    "uservisible": true,
    "component": null,
    "itemid": null,
    "modules": [
      {
        "id": 703,
        "url": "https://course.innovate-us.org/mod/videotime/view.php?id=703",
        "name": "What Is AI?",
        "instance": 5,
        "contextid": 76086,
        "description": "<div class=\"no-overflow\"><div style=\"background-color: #eef5fb; border-radius: 8px; padding: 20px 24px; margin: 0 0 16px 0; text-align: center;\">\r\n<p style=\"margin: 0 0 12px 0; font-size: 1.05rem; line-height: 1.6; color: #1d2b36;\">Establishes a shared baseline definition of AI and explains why your instructions are the most important factor in getting useful output.</p>\r\n<p style=\"margin: 0; font-size: 0.95rem; color: #33475b;\"><strong>Happy learning!</strong><br>Do you have questions? Send an email to <a href=\"mailto:hello@innovate-us.org\">hello@innovate-us.org</a></p>\r\n</div></div>",
        "visible": 1,
        "uservisible": true,
        "visibleoncoursepage": 1,
        "modicon": "https://course.innovate-us.org/theme/image.php/norse/videotime/1795104600/monologo?filtericon=1",
