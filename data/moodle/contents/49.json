  {
    "id": 381,
    "name": "3. AI Applications Across the Procurement Lifecycle",
    "visible": 1,
    "summary": "<p>Where AI can help at each stage of the procurement lifecycle — and where human judgment must stay in charge.</p>",
    "summaryformat": 1,
    "section": 3,
    "hiddenbynumsections": 0,
    "uservisible": true,
    "component": null,
    "itemid": null,
    "modules": [
      {
        "id": 706,
        "url": "https://course.innovate-us.org/mod/videotime/view.php?id=706",
        "name": "The Procurement Lifecycle and Where AI Fits",
        "instance": 8,
        "contextid": 76089,
        "description": "<div class=\"no-overflow\"><div style=\"background-color: #eef5fb; border-radius: 8px; padding: 20px 24px; margin: 0 0 16px 0; text-align: center;\">\r\n<p style=\"margin: 0 0 12px 0; font-size: 1.05rem; line-height: 1.6; color: #1d2b36;\">A stage-by-stage walk through the procurement lifecycle showing where AI can help at each step, with real-world case study previews woven throughout to connect the framework to practice.</p>\r\n<p style=\"margin: 0; font-size: 0.95rem; color: #33475b;\"><strong>Happy learning!</strong><br>Do you have questions? Send an email to <a href=\"mailto:hello@innovate-us.org\">hello@innovate-us.org</a></p>\r\n</div></div>",
