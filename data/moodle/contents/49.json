      {
        "id": 705,
        "url": "https://course.innovate-us.org/mod/videotime/view.php?id=705",
        "name": "Working With AI: Limits, Roles, and What Changes",
        "instance": 7,
        "contextid": 76088,
        "description": "<div class=\"no-overflow\"><div style=\"background-color: #eef5fb; border-radius: 8px; padding: 20px 24px; margin: 0 0 16px 0; text-align: center;\">\r\n<p style=\"margin: 0 0 12px 0; font-size: 1.05rem; line-height: 1.6; color: #1d2b36;\">Covers the clear boundaries of AI in a procurement context and examines trends shaping how the procurement workforce will evolve alongside these tools.</p>\r\n<p style=\"margin: 0; font-size: 0.95rem; color: #33475b;\"><strong>Happy learning!</strong><br>Do you have questions? Send an email to <a href=\"mailto:hello@innovate-us.org\">hello@innovate-us.org</a></p>\r\n</div></div>",
