      {
        "id": 711,
        "url": "https://course.innovate-us.org/mod/videotime/view.php?id=711",
        "name": "Austin, TX: Incremental Change for Big Efficiency Gains",
        "instance": 13,
        "contextid": 76094,
        "description": "<div class=\"no-overflow\"><div style=\"background-color: #eef5fb; border-radius: 8px; padding: 20px 24px; margin: 0 0 16px 0; text-align: center;\">\r\n<p style=\"margin: 0 0 12px 0; font-size: 1.05rem; line-height: 1.6; color: #1d2b36;\">Austin worked to find the small, repetitive tasks in procurement where AI could save time, including using AI to analyze contract history before vendor negotiations.</p>\r\n<p style=\"margin: 0; font-size: 0.95rem; color: #33475b;\"><strong>Happy learning!</strong><br>Do you have questions? Send an email to <a href=\"mailto:hello@innovate-us.org\">hello@innovate-us.org</a></p>\r\n</div></div>",
