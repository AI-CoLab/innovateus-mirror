    "name": "5. AI Risk Management",
    "visible": 1,
    "summary": "<p>How to identify and manage the risks of AI adoption through strong governance and consistent human oversight.</p>",
    "summaryformat": 1,
    "section": 5,
    "hiddenbynumsections": 0,
