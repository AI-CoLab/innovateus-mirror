      {
        "id": 704,
        "url": "https://course.innovate-us.org/mod/videotime/view.php?id=704",
        "name": "Why AI Matters in Procurement",
        "instance": 6,
        "contextid": 76087,
        "description": "<div class=\"no-overflow\"><div style=\"background-color: #eef5fb; border-radius: 8px; padding: 20px 24px; margin: 0 0 16px 0; text-align: center;\">\r\n<p style=\"margin: 0 0 12px 0; font-size: 1.05rem; line-height: 1.6; color: #1d2b36;\">Explores three key ways AI can improve procurement processes: synthesizing large volumes of information, automating routine workloads, and supporting better data-driven decisions.</p>\r\n<p style=\"margin: 0; font-size: 0.95rem; color: #33475b;\"><strong>Happy learning!</strong><br>Do you have questions? Send an email to <a href=\"mailto:hello@innovate-us.org\">hello@innovate-us.org</a></p>\r\n</div></div>",
        "visible": 1,
        "uservisible": true,
