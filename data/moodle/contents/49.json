      {
        "id": 708,
        "url": "https://course.innovate-us.org/mod/videotime/view.php?id=708",
        "name": "Westminster, CO: Building a Procurement Operation from the Ground Up with AI",
        "instance": 10,
        "contextid": 76091,
        "description": "<div class=\"no-overflow\"><div style=\"background-color: #eef5fb; border-radius: 8px; padding: 20px 24px; margin: 0 0 16px 0; text-align: center;\">\r\n<p style=\"margin: 0 0 12px 0; font-size: 1.05rem; line-height: 1.6; color: #1d2b36;\">Westminster's Procurement Manager built an AI-powered operating system for a small, overwhelmed team, showing that AI can be used to scale procurement expertise.</p>\r\n<p style=\"margin: 0; font-size: 0.95rem; color: #33475b;\"><strong>Happy learning!</strong><br>Do you have questions? Send an email to <a href=\"mailto:hello@innovate-us.org\">hello@innovate-us.org</a></p>\r\n</div></div>",
        "visible": 1,
        "uservisible": true,
        "visibleoncoursepage": 1,
        "modicon": "https://course.innovate-us.org/theme/image.php/norse/videotime/1795104600/monologo?filtericon=1",
