  {
    "id": 382,
    "name": "4. Practical Applications in AI Procurement",
    "visible": 1,
    "summary": "<p>How four jurisdictions turned to AI to solve real procurement problems, and what they learned along the way.</p>",
    "summaryformat": 1,
    "section": 4,
    "hiddenbynumsections": 0,
    "uservisible": true,
    "component": null,
    "itemid": null,
    "modules": [
      {
        "id": 707,
        "url": "https://course.innovate-us.org/mod/videotime/view.php?id=707",
        "name": "Practical AI Applications in Procurement",
        "instance": 9,
        "contextid": 76090,
        "description": "<div class=\"no-overflow\"><div style=\"background-color: #eef5fb; border-radius: 8px; padding: 20px 24px; margin: 0 0 16px 0; text-align: center;\">\r\n<p style=\"margin: 0 0 12px 0; font-size: 1.05rem; line-height: 1.6; color: #1d2b36;\">Introduces the module's framing: every case study starts with a real problem, not a technology strategy, and AI adoption doesn't have to mean a massive overhaul.</p>\r\n<p style=\"margin: 0; font-size: 0.95rem; color: #33475b;\"><strong>Happy learning!</strong><br>Do you have questions? Send an email to <a href=\"mailto:hello@innovate-us.org\">hello@innovate-us.org</a></p>\r\n</div></div>",
        "visible": 1,
        "uservisible": true,
        "visibleoncoursepage": 1,
        "modicon": "https://course.innovate-us.org/theme/image.php/norse/videotime/1795104600/monologo?filtericon=1",
