      {
        "id": 593,
        "url": "https://course.innovate-us.org/mod/scorm/view.php?id=593",
        "name": "Course Overview",
        "instance": 52,
        "contextid": 15596,
        "description": "<div class=\"no-overflow\"><h4>Module 1: Course Overview </h4>\r\n<p>This module introduces the course and highlights the transformative potential of Generative AI (GenAI) in the public sector. Participants will gain an understanding of how GenAI can assist them in their work through hands-on activities and best practices. The importance of delivering value while maintaining public trust and safety is emphasized.</p>\r\n<p>Click \"Start Module\" to begin! This module may take a few moments to load on slower connections. Thank you for your patience!</p>\r\n<p> Have questions or need assistance? Write to us at  <a href=\"mailto:hello@innovate-us.org\">hello@innovate-us.org</a></p></div>",
        "visible": 1,
        "uservisible": true,
        "visibleoncoursepage": 1,
        "modicon": "https://course.innovate-us.org/theme/image.php/norse/scorm/1795104600/monologo?filtericon=1",
