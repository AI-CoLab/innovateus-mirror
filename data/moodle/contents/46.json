[
  {
    "id": 349,
    "name": "General",
    "visible": 1,
    "summary": "<div style=\"background-color: #fafafa; padding: 2rem;\">\r\n<h3>Welcome!</h3>\r\n<p dir=\"ltr\" style=\"text-align: left;\">This course provides public sector professionals with a practical understanding of community engagement and its role in improving public service delivery. Through hands-on activities and best practices, participants learn to design and run engagement as a powerful tool for connecting with the communities they serve. The course covers the fundamentals of engagement, practical approaches across contexts, methods for consultation, deliberation, and co-creation, and strategies for genuinely listening to communities. By the end of the course, participants will be equipped to plan and deliver engagement effectively and confidently in their public sector roles.</p>\r\n<p><strong>All the examples, case studies and resources mentioned in this course can be found <a href=\"https://innovate-us.org/resources/democratic-engagement-for-ai-era\" target=\"_blank\" rel=\"noopener\"> here</a></strong></p>\r\n<p dir=\"ltr\" style=\"text-align: left;\">Have any questions or need assistance? Write to us at hello@innovate-us.org!</p>\r\n</div>",
    "summaryformat": 1,
    "section": 0,
    "hiddenbynumsections": 0,
    "uservisible": true,
    "component": null,
    "itemid": null,
    "modules": []
  },
